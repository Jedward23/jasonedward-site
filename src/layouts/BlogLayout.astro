---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  readTime?: string;
  slug?: string;
}

const { title, description, pubDate, readTime, slug } = Astro.props;
const shareUrl = `https://jasonedward.me/blog/${slug ?? ''}`;
const shareText = `${title} by Jason Edward`;
---

<Layout title={`${title} | Jason Edward`} description={description} type="article">
  <Header />
  <main id="main-content" class="page-shell article-page">
    <article>
      <header class="article-header">
        <a class="back-link" href="/blog"><span aria-hidden="true">←</span> All writing</a>
        <p class="eyebrow"><span></span> Essay</p>
        <h1>{title}</h1>
        <p class="article-description">{description}</p>
        <div class="article-meta">
          <time datetime={pubDate.toISOString()}>
            {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          {readTime && <span>{readTime}</span>}
        </div>
      </header>

      <div class="prose">
        <slot />
      </div>

      <footer class="article-footer">
        <p class="eyebrow"><span></span> Share this essay</p>
        <div class="share-links">
          <a href={`https://x.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(shareUrl)}`} target="_blank" rel="noopener noreferrer">Post on X <span aria-hidden="true">↗</span></a>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
          <button type="button" data-copy-link={shareUrl}>Copy link</button>
        </div>
      </footer>
    </article>
  </main>
  <Footer />
</Layout>

<script>
  function setupCopyLink() {
    const button = document.querySelector<HTMLButtonElement>('[data-copy-link]');
    if (!button || button.dataset.ready === 'true') return;
    button.dataset.ready = 'true';
    button.addEventListener('click', async () => {
      const url = button.dataset.copyLink;
      if (!url) return;
      try {
        await navigator.clipboard.writeText(url);
        const previous = button.textContent;
        button.textContent = 'Copied';
        window.setTimeout(() => { button.textContent = previous; }, 1800);
      } catch {
        button.textContent = 'Copy failed';
      }
    });
  }

  setupCopyLink();
  document.addEventListener('astro:after-swap', setupCopyLink);
</script>
