---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  index?: string;
  headingLevel?: 2 | 3;
}

const { post, index, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="post-card">
  <a href={`/blog/${post.slug}`} aria-label={`Read ${post.data.title}`}>
    <div class="post-card-meta">
      {index && <span>{index}</span>}
      <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
      {post.data.readTime && <span>{post.data.readTime}</span>}
    </div>
    <Heading>{post.data.title}</Heading>
    <p>{post.data.description}</p>
    <span class="post-card-link">Read essay <span aria-hidden="true">→</span></span>
  </a>
</article>
