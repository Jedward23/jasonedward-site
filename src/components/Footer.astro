---
const socialLinks = [
  { href: 'https://github.com/Jedward23', label: 'GitHub' },
  { href: 'https://x.com/jasonedward97', label: 'X' },
  { href: 'https://www.linkedin.com/in/jedwardnicoll', label: 'LinkedIn' },
  { href: '/rss.xml', label: 'RSS', external: false },
];
---

<footer class="site-footer">
  <div class="footer-inner page-shell">
    <div>
      <a class="footer-name" href="/">Jason Edward</a>
      <p>Cofounder of <a href="https://frosted.co" target="_blank" rel="noopener noreferrer">Frosted</a>. Founder of <a href="https://sourcewave.ai" target="_blank" rel="noopener noreferrer">Source Wave</a>.</p>
    </div>

    <div class="footer-links" aria-label="Social links">
      {socialLinks.map(({ href, label, external = true }) => (
        <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>{label}</a>
      ))}
    </div>

    <p class="footer-meta">&copy; {new Date().getFullYear()} Jason Edward</p>
  </div>
</footer>
