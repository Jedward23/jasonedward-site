---
const { pathname } = Astro.url;
const writingActive = pathname.startsWith('/blog');
const sectionHref = (section: string) => pathname === '/' ? `#${section}` : `/#${section}`;
---

<header class="site-header">
  <a class="skip-link" href="#main-content">Skip to content</a>
  <div class="header-inner page-shell">
    <a class="wordmark" href="/" aria-label="Jason Edward, home">
      <span class="wordmark-name">Jason Edward</span>
      <span class="wordmark-role">Founder / Operator</span>
    </a>

    <nav class="primary-nav" aria-label="Primary navigation">
      <a href={sectionHref('companies')}>Companies</a>
      <a href="/blog" aria-current={writingActive ? 'page' : undefined}>Writing</a>
      <a href={sectionHref('about')}>About</a>
      <a class="nav-contact" href="mailto:jason@frosted.co">Contact</a>
    </nav>
  </div>
</header>
