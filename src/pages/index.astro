---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CompanyCard from '../components/CompanyCard.astro';
import PostCard from '../components/PostCard.astro';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout>
  <Header />
  <main id="main-content">
    <section class="hero page-shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> Founder / Operator / Builder</p>
        <h1 id="hero-title">Building <em>systems</em><br />that compound.</h1>
        <p class="hero-intro">
          I’m Jason, cofounder of <a href="https://frosted.co" target="_blank" rel="noopener noreferrer">Frosted.co</a> and founder of <a href="https://sourcewave.ai" target="_blank" rel="noopener noreferrer">Source Wave</a>. I build companies, software, and operating systems for modern work.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#companies">Explore the companies <span aria-hidden="true">↓</span></a>
          <a class="button button-quiet" href="/blog">Read the writing <span aria-hidden="true">→</span></a>
        </div>
        <div class="hero-signal" aria-label="Current focus">
          <span class="signal-dot"></span>
          <span>Currently building from Bali, Indonesia</span>
        </div>
      </div>

      <figure class="hero-portrait">
        <div class="portrait-light portrait-light--blue"></div>
        <div class="portrait-light portrait-light--amber"></div>
        <div class="portrait-frame">
          <img src="/jason-profile.jpg" alt="Jason Edward working in front of the Dubai skyline at night" width="960" height="1280" loading="eager" fetchpriority="high" />
        </div>
        <figcaption>
          <span>Jason Edward</span>
          <span>Building at the intersection of operations and AI</span>
        </figcaption>
      </figure>
    </section>

    <section id="companies" class="section page-shell" aria-labelledby="companies-title">
      <div class="section-heading">
        <p class="eyebrow"><span></span> The work</p>
        <div>
          <h2 id="companies-title">Two ways I <em>build.</em></h2>
          <p>One is grounded in operating a real service business. The other is focused on creating the systems that come next.</p>
        </div>
      </div>

      <div class="company-grid">
        <CompanyCard
          index="01"
          role="Cofounder"
          name="Frosted"
          headline="Retention, designed to last."
          description="Frosted is the ecommerce retention agency I co-founded to help ambitious brands compound customer value through lifecycle strategy and creative."
          href="https://frosted.co"
          tone="amber"
        />
        <CompanyCard
          index="02"
          role="Founder"
          name="Source Wave"
          headline="Building for the agentic era."
          description="Source Wave is the parent company I founded to build focused software for the next operating model. Its portfolio includes Fern and Axis."
          href="https://sourcewave.ai"
          tone="blue"
          products={[
            { label: 'Fern', href: 'https://usefern.ai' },
            { label: 'Axis', href: 'https://tryaxis.so' },
          ]}
        />
      </div>
    </section>

    <section id="writing" class="section section-writing page-shell" aria-labelledby="writing-title">
      <div class="section-heading section-heading--compact">
        <p class="eyebrow"><span></span> From the field</p>
        <div>
          <h2 id="writing-title">Notes from <em>the work.</em></h2>
          <p>Practical essays on autonomous agents, company systems, and what breaks when theory meets operations.</p>
        </div>
      </div>

      <div class="post-grid">
        {posts.slice(0, 4).map((post, index) => <PostCard post={post} index={String(index + 1).padStart(2, '0')} />)}
      </div>
      <a class="text-link writing-link" href="/blog">View all writing <span aria-hidden="true">→</span></a>
    </section>

    <section id="about" class="section page-shell" aria-labelledby="about-title">
      <div class="about-panel">
        <div class="about-statement">
          <p class="eyebrow"><span></span> Operating thesis</p>
          <h2 id="about-title">Better companies start with better <em>systems.</em></h2>
        </div>
        <div class="principles">
          <div class="principle">
            <span>01</span>
            <div><h3>Operate close to reality.</h3><p>The useful lessons come from running the work, not commenting from the sidelines.</p></div>
          </div>
          <div class="principle">
            <span>02</span>
            <div><h3>Turn judgment into infrastructure.</h3><p>The best process captures what experts know and makes it repeatable without making it rigid.</p></div>
          </div>
          <div class="principle">
            <span>03</span>
            <div><h3>Build for compounding leverage.</h3><p>People should spend their time on decisions that matter while systems carry the rest.</p></div>
          </div>
        </div>
      </div>
    </section>

    <section class="contact-section page-shell" aria-labelledby="contact-title">
      <p class="eyebrow"><span></span> Get in touch</p>
      <div>
        <h2 id="contact-title">Working on something<br /><em>that should exist?</em></h2>
        <a class="button button-primary" href="mailto:jason@frosted.co">Start a conversation <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
