---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout title="Writing | Jason Edward" description="Practical essays by Jason Edward on autonomous agents, company systems, and building for the agentic era.">
  <Header />
  <main id="main-content" class="page-shell writing-page">
    <header class="writing-hero">
      <p class="eyebrow"><span></span> Writing</p>
      <h1>Notes from<br /><em>the work.</em></h1>
      <p>Practical essays on autonomous agents, company systems, and what breaks when theory meets operations.</p>
    </header>

    <section aria-label="All essays" class="writing-list">
      {posts.map((post, index) => <PostCard post={post} index={String(index + 1).padStart(2, '0')} headingLevel={2} />)}
    </section>
  </main>
  <Footer />
</Layout>
